import { ListView } from "std-widgets.slint";
import { Theme, Icons, Segment } from "theme.slint";

export component Icon inherits Rectangle {
    in property <string> shape;
    in property <color> tint: Theme.text-muted;
    in property <length> thickness: 1.3px;

    width: 16px;
    height: 16px;
    horizontal-stretch: 0;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.shape;
        stroke: root.tint;
        stroke-width: root.thickness;
    }
}

export component ThemeButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;

    height: Theme.control;
    min-width: caption.preferred-width + 26px;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.primary ? transparent : Theme.glass-line;

    background: root.primary
        ? (touch.pressed ? Theme.fill-press : (touch.has-hover ? Theme.fill-hover : Theme.fill))
        : (touch.pressed ? Theme.glass-press : (touch.has-hover ? Theme.glass-hover : Theme.glass));

    animate background { duration: 120ms; }

    caption := Text {
        text: root.label;
        font-family: Theme.sans;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        color: root.primary ? Theme.on-fill : Theme.text-soft;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component RoundButton inherits Rectangle {
    in property <string> shape;
    callback clicked;

    width: 34px;
    height: 34px;
    horizontal-stretch: 0;
    border-radius: self.width / 2;
    background: touch.pressed ? Theme.glass-press : (touch.has-hover ? Theme.glass-hover : Theme.glass);

    animate background { duration: 120ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 3px;

        if root.shape == "": HorizontalLayout {
            spacing: 3px;

            for dot in 3: VerticalLayout {
                alignment: center;
                Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: Theme.text-soft; }
            }
        }

        if root.shape != "": VerticalLayout {
            alignment: center;

            Icon {
                shape: root.shape;
                width: 15px;
                height: 15px;
                tint: Theme.text-soft;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ThemeInput inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <length> text-size: 13px;
    in property <bool> flat: false;
    callback edited(string);

    forward-focus: field;

    height: root.flat ? 52px : Theme.control;
    border-radius: root.flat ? 0px : Theme.radius;
    border-width: root.flat ? 0px : 1px;
    border-color: field.has-focus ? Theme.accent : Theme.glass-line;
    background: root.flat ? transparent : Theme.glass;

    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: root.flat ? 4px : 11px;
        padding-right: root.flat ? 4px : 11px;
        spacing: 10px;

        if root.flat: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Icon {
                shape: Icons.search;
                width: 18px;
                height: 18px;
            }
        }

        Rectangle {
            clip: true;

            field := TextInput {
                width: parent.width;
                height: parent.height;
                text: root.text;
                font-family: Theme.sans;
                font-size: root.text-size;
                color: Theme.text-strong;
                selection-background-color: Theme.mark;
                selection-foreground-color: Theme.on-mark;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
            }

            if field.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                font-family: Theme.sans;
                font-size: root.text-size;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component ThemeSelect inherits Rectangle {
    in property <[string]> options;
    in property <string> label;
    callback picked(int);

    height: Theme.control;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.glass-line;
    background: touch.has-hover ? Theme.glass-hover : Theme.glass;

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 9px;
        spacing: 6px;

        Text {
            text: root.label;
            font-family: Theme.sans;
            font-size: 13px;
            color: Theme.text-soft;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Icon {
                shape: Icons.chevron;
                width: 14px;
                height: 14px;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }

    menu := PopupWindow {
        y: root.height + 5px;
        width: root.width;
        height: min(240px, root.options.length * 32px + 10px);
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.deep;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #0d1a2b99;

            ListView {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;

                for option[index] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: row.has-hover ? Theme.glass-hover : transparent;

                    Text {
                        x: 9px;
                        width: parent.width - 18px;
                        text: option;
                        font-family: Theme.sans;
                        font-size: 13px;
                        color: Theme.text-soft;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.picked(index);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

export component ThemeCheck inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);

    height: 26px;

    HorizontalLayout {
        alignment: start;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Rectangle {
                width: 17px;
                height: 17px;
                border-radius: 5px;
                border-width: 1px;
                border-color: root.checked ? Theme.fill : Theme.glass-line;
                background: root.checked ? Theme.fill : Theme.glass;

                animate background, border-color { duration: 120ms; }

                Path {
                    width: 11px;
                    height: 11px;
                    viewbox-width: 11;
                    viewbox-height: 11;
                    commands: "M 2 5.5 L 4.5 8 L 9 3";
                    stroke: Theme.on-fill;
                    stroke-width: 1.6px;
                    visible: root.checked;
                }
            }
        }

        Text {
            text: root.label;
            font-family: Theme.sans;
            font-size: 13px;
            color: Theme.text-soft;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component SectionTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> note;

    spacing: 4px;

    Text {
        text: root.title;
        font-family: Theme.sans;
        font-size: 14px;
        font-weight: 600;
        color: Theme.text-strong;
    }

    Text {
        text: root.note;
        font-family: Theme.sans;
        font-size: 12px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}

export component Panel inherits Rectangle {
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.glass-line;
    background: Theme.glass;
}

export component SegmentLine inherits Rectangle {
    in property <[Segment]> parts;
    in property <length> size;
    in property <color> tone;
    in property <string> face;

    clip: true;

    HorizontalLayout {
        alignment: start;
        spacing: 0px;

        for part in parts: Rectangle {
            width: label.preferred-width + (part.hit ? 6px : 0px);
            border-radius: 4px;
            background: part.hit ? Theme.mark : transparent;

            label := Text {
                text: part.text;
                font-family: root.face;
                font-size: root.size;
                font-weight: part.hit ? 600 : 400;
                color: part.hit ? Theme.on-mark : root.tone;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

export component HintRow inherits Rectangle {
    in property <string> shape;
    in property <string> title;
    in property <string> note;
    in property <bool> actionable: false;
    callback activated;

    height: 46px;
    border-radius: Theme.radius;
    background: (root.actionable && touch.has-hover) ? Theme.glass : transparent;

    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Icon { shape: root.shape; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                font-family: Theme.sans;
                font-size: 13px;
                font-weight: 500;
                color: Theme.text-strong;
                overflow: elide;
            }

            Text {
                text: root.note;
                font-family: Theme.sans;
                font-size: 11px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        enabled: root.actionable;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <string> shape;
    callback chosen();

    height: 30px;
    border-radius: 6px;
    background: hit.has-hover ? Theme.glass-hover : transparent;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 9px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Icon {
                shape: root.shape;
                width: 14px;
                height: 14px;
            }
        }

        Text {
            text: root.label;
            font-family: Theme.sans;
            font-size: 13px;
            color: Theme.text-soft;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}
