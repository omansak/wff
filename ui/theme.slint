export struct Segment {
    text: string,
    hit: bool,
}

export struct ResultRow {
    header: [Segment],
    body: [Segment],
    has-body: bool,
    path: string,
    line: int,
}

export struct OpenRule {
    extension: string,
    command: string,
}

export global Theme {
    out property <color> deep: #223A5E;
    out property <color> accent: #6E9ECC;
    out property <color> light: #9FC0E3;
    out property <color> very-light: #D0E1F2;
    out property <color> off-white: #F3F8FD;

    out property <color> text-strong: Theme.off-white;
    out property <color> text-soft: Theme.very-light;
    out property <color> text-muted: Theme.light;

    out property <color> glass: #F3F8FD1a;
    out property <color> glass-hover: #F3F8FD2b;
    out property <color> glass-press: #F3F8FD3d;
    out property <color> glass-line: #D0E1F233;

    out property <color> card: transparent;
    out property <color> card-solid: #1b2f4d;
    out property <color> card-line: #9FC0E338;

    out property <color> mark: Theme.light;
    out property <color> on-mark: Theme.deep;

    out property <color> fill: Theme.very-light;
    out property <color> fill-hover: Theme.off-white;
    out property <color> fill-press: Theme.light;
    out property <color> on-fill: Theme.deep;

    out property <length> radius: 8px;
    out property <length> control: 34px;
    out property <string> sans: "Segoe UI Variable";
    out property <string> mono: "Consolas";
}

