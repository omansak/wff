1 ICON "assets/icon.ico"

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     0,1,1,0
PRODUCTVERSION  0,1,1,0
FILEFLAGSMASK   0x3f
FILEFLAGS       0x0
FILEOS          0x40004
FILETYPE        0x1
FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OMANSAK"
            VALUE "FileDescription",  "wff - fuzzy file finder"
            VALUE "FileVersion",      "0.1.1.0"
            VALUE "InternalName",     "wff"
            VALUE "LegalCopyright",   "Copyright (C) 2026 OMANSAK"
            VALUE "OriginalFilename", "wff.exe"
            VALUE "ProductName",      "wff"
            VALUE "ProductVersion",   "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
